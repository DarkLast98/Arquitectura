<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Npgsql" Version="10.0.3" /><PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" /></ItemGroup>
  <ItemGroup><Content Include="../../contracts/**" Link="contracts/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup>
    <Compile Remove="Modules/Catalog/Domain/**" />
    <Content Remove="Modules/Catalog/Domain/bin/**;Modules/Catalog/Domain/obj/**" />
    <ProjectReference Include="Modules/Catalog/Domain/Aip.Catalog.Domain.csproj" />
  </ItemGroup>
</Project>
